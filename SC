--==================================================
-- BUTTON FEEDBACK: soft ripple + small blue particle burst.
--==================================================
local function spawnClickEffect(button)
    if not button or not button.Parent then
        return
    end

    local center = button.AbsolutePosition + (button.AbsoluteSize / 2)
    local layerOrigin = effectsLayer.AbsolutePosition
    local x = center.X - layerOrigin.X
    local y = center.Y - layerOrigin.Y

    local ring = Instance.new("Frame")
    ring.Name = "ClickRipple"
    ring.AnchorPoint = Vector2.new(0.5, 0.5)
    ring.Position = UDim2.fromOffset(x, y)
    ring.Size = UDim2.fromOffset(7, 7)
    ring.BackgroundTransparency = 1
    ring.BorderSizePixel = 0
    ring.ZIndex = 110
    ring.Parent = effectsLayer

    local ringCorner = Instance.new("UICorner")
    ringCorner.CornerRadius = UDim.new(1, 0)
    ringCorner.Parent = ring

    local ringStroke = Instance.new("UIStroke")
    ringStroke.Color = Color3.fromRGB(151, 171, 193)
    ringStroke.Thickness = 2
    ringStroke.Transparency = 0.12
    ringStroke.Parent = ring

    TweenService:Create(ring, TweenInfo.new(0.34, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = UDim2.fromOffset(52, 52)
    }):Play()
    TweenService:Create(ringStroke, TweenInfo.new(0.34, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Transparency = 1,
        Thickness = 0.5
    }):Play()
    Debris:AddItem(ring, 0.42)

    for i = 1, 7 do
        local angle = ((math.pi * 2) / 7) * i
        local startX = x + math.cos(angle) * 4
        local startY = y + math.sin(angle) * 4
        local endX = x + math.cos(angle) * math.random(19, 29)
        local endY = y + math.sin(angle) * math.random(19, 29)

        local dot = Instance.new("Frame")
        dot.Name = "ClickParticle"
