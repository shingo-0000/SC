end)

-- PLAYER LISTS
local selectedNamePlayer

local function populatePlayerList(list, search, getSelected, setSelected, selectedText)
    for _, child in ipairs(list:GetChildren()) do
        if child:IsA("TextButton") or child.Name == "EmptyState" then
            child:Destroy()
        end
    end

    local query = string.lower(search.Text)
    local found = false

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local searchable = string.lower(player.Name .. " " .. player.DisplayName)
            if query == "" or string.find(searchable, query, 1, true) then
                found = true
                local isSelected = getSelected() == player
                local button = Instance.new("TextButton")
                button.Size = UDim2.new(1, -4, 0, 31)
                button.BackgroundColor3 = isSelected
                    and Color3.fromRGB(72, 94, 119)
                    or Color3.fromRGB(29, 40, 55)
                button.BorderSizePixel = 0
                button.Text = "   " .. player.DisplayName .. "   (@" .. player.Name .. ")"
                button.TextColor3 = Color3.fromRGB(239, 243, 249)
                button.TextStrokeColor3 = Color3.fromRGB(144, 160, 181)
                button.TextStrokeTransparency = 1
                button.Font = Enum.Font.GothamMedium
                button.TextSize = 12
                button.TextXAlignment = Enum.TextXAlignment.Left
                button.AutoButtonColor = false
                button.Parent = list
                local corner = Instance.new("UICorner")
                corner.CornerRadius = UDim.new(0, 6)
                corner.Parent = button
                addButtonFeedback(button)
                button.Activated:Connect(function()
                    setSelected(player)
                    selectedText.Text = "SELECTED PLAYER  /  " .. player.Name
                    -- Refresh both lists so selection is consistent on page switches.
                    task.defer(function()
                        refreshAppearancePlayers()
                        refreshNamePlayers()
                    end)
                end)
            end
        end
    end

    if not found then
        local empty = Instance.new("TextLabel")
        empty.Name = "EmptyState"
        empty.Size = UDim2.new(1, -8, 0, 30)
        empty.BackgroundTransparency = 1
        empty.Text = "No matching players found"
        empty.TextColor3 = Color3.fromRGB(147, 164, 185)
        empty.Font = Enum.Font.GothamMedium
        empty.TextSize = 12
        empty.Parent = list
    end
end

