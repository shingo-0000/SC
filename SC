local function addButtonFeedback(button)
    local scale = Instance.new("UIScale")
    scale.Scale = 1
    scale.Parent = button

    local pressInfo = TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local releaseInfo = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local activeTween

    local function animate(value, info)
        if activeTween then
            activeTween:Cancel()
        end
        activeTween = TweenService:Create(scale, info, {Scale = value})
        activeTween:Play()
    end

    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            animate(0.965, pressInfo)
        end
    end)

    button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            animate(1, releaseInfo)
        end
    end)

    button.Activated:Connect(function()
        animate(1, releaseInfo)
        spawnClickEffect(button)
    end)
end

