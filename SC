local connections = {}

local function connect(signal, callback)
    local c = signal:Connect(callback)
    table.insert(connections, c)
    return c
end

local BODY_PARTS = {
    Head = true,
    Torso = true,
    ["Left Arm"] = true,
    ["Right Arm"] = true,
    ["Left Leg"] = true,
    ["Right Leg"] = true,
    UpperTorso = true,
    LowerTorso = true,
    LeftUpperArm = true,
    LeftLowerArm = true,
    LeftHand = true,
    RightUpperArm = true,
    RightLowerArm = true,
    RightHand = true,
    LeftUpperLeg = true,
    LeftLowerLeg = true,
    LeftFoot = true,
    RightUpperLeg = true,
    RightLowerLeg = true,
    RightFoot = true
}

local function restoreAppearance(target)
    local targetsToRestore = {}

    if target then
        table.insert(targetsToRestore, target)
    else
        for player in pairs(activeAppearanceStates) do
            table.insert(targetsToRestore, player)
        end
    end

    for _, player in ipairs(targetsToRestore) do
        local state = activeAppearanceStates[player]
        if state then
            activeAppearanceStates[player] = nil

            if state.respawnConnection then
                pcall(function()
                    state.respawnConnection:Disconnect()
                end)
            end

            -- Remove copied accessories, visual children, and any fallback mesh shells.
            for _, obj in ipairs(state.added) do
                pcall(function()
                    obj:Destroy()
                end)
            end

            -- Restore original accessories, clothing, and visual mesh children.
            for _, entry in ipairs(state.originals) do
                pcall(function()
                    if entry.object then
                        entry.object.Parent = entry.parent
                    end
                end)
            end

            -- Restore original body colors and the target's original head visibility.
            for part, color in pairs(state.colors) do
                pcall(function()
                    if part.Parent then
                        part.Color = color
                    end
                end)
            end

            if state.headVisuals and state.headVisuals.part then
                pcall(function()
                    local head = state.headVisuals.part
                    if head.Parent then
                        head.Transparency = state.headVisuals.transparency
                        head.LocalTransparencyModifier = state.headVisuals.localTransparencyModifier
                    end
                end)
            end

        end
    end
end

local function saveAndRemove(obj, state)
    table.insert(state.originals, {
        object = obj,
        parent = obj.Parent
    })

    obj.Parent = nil
end

local function getBodyParts(character)
    local result = {}

    for _, obj in ipairs(character:GetChildren()) do
        if obj:IsA("BasePart") and BODY_PARTS[obj.Name] then
            result[obj.Name] = obj
        end
    end

    return result
end

local function applyAccessory(accessory, character, state, bodyParts)
    local clone = accessory:Clone()
    local handle = clone:FindFirstChild("Handle")

    if not handle or not handle:IsA("BasePart") then
        clone:Destroy()
        return false
    end

    local hasWrapLayer = false
    for _, obj in ipairs(handle:GetDescendants()) do
        if obj:IsA("WrapLayer") then
            hasWrapLayer = true
        elseif obj:IsA("Weld") and obj.Name == "AccessoryWeld" then
            -- The preview weld refers to the temporary preview rig.
            obj:Destroy()
        end
    end

    handle.CanCollide = false
    handle.CanTouch = false
    handle.CanQuery = false
    handle.Massless = true
    handle.Anchored = false

    local attached = false

    -- Rebuild the attachment weld against the preserved target rig. Keep the
    -- accessory's WrapLayer intact so layered clothing can deform over the
    -- matching WrapTarget copied to the target body part.
    for _, handleAttachment in ipairs(handle:GetDescendants()) do
        if handleAttachment:IsA("Attachment") then
            for _, bodyPart in pairs(bodyParts) do
                local targetAttachment =
                    bodyPart:FindFirstChild(handleAttachment.Name, true)

                if targetAttachment and targetAttachment:IsA("Attachment") then
                    clone.Parent = character

                    local weld = Instance.new("Weld")
                    weld.Name = "AccessoryWeld"
                    weld.Part0 = bodyPart
                    weld.Part1 = handle
                    weld.C0 = targetAttachment.CFrame
                    weld.C1 = handleAttachment.CFrame
                    weld.Parent = handle

                    attached = true
                    break
                end
            end
        end

        if attached then break end
    end

    -- Some layered accessories are set up to be attached by the Humanoid.
    -- Let Roblox perform its normal accessory attachment as a fallback rather
    -- than dropping the clothing merely because the manual attachment lookup
    -- did not find a matching Attachment.
    if not attached and hasWrapLayer then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            local ok = pcall(function()
                humanoid:AddAccessory(clone)
            end)
            attached = ok and clone.Parent == character
        end
    end

    if not attached then
        clone:Destroy()
        return false
    end

    table.insert(state.added, clone)
    return true
end

local function accessoryHasRuntimeEffects(accessory)
    local effectClasses = {
        ParticleEmitter = true,
        Beam = true,
        Trail = true,
        Fire = true,
        Smoke = true,
        Sparkles = true,
        Highlight = true
    }

    for _, obj in ipairs(accessory:GetDescendants()) do
        if effectClasses[obj.ClassName] then
            return true
        end
    end

    -- Preserve game-created accessories whose type is not a standard avatar
    -- slot. These often contain custom aura/effect rigs or game references.
    local ok, accessoryType = pcall(function()
        return accessory.AccessoryType
    end)
    if ok and accessoryType == Enum.AccessoryType.Unknown then
        return true
    end

    return false
end

local function copyObject(source, destination, state)
    if not source then return end

    local clone = source:Clone()
    clone.Parent = destination

    table.insert(state.added, clone)
end

--==================================================
-- R6 BUNDLE TRANSFER (NATIVE CHARACTERMESH)
--==================================================
-- R6 avatars use CharacterMesh instances to render package body meshes.
-- Copying these objects is the native, Dex-like way to change R6 bundles:
-- the six live BaseParts, Motor6Ds, Attachments, constraints, and game-owned
-- effect references remain untouched. CharacterMesh also carries the R6
-- base/overlay texture layers used by classic avatar packages.
--
-- This version intentionally supports bundle geometry on R6 only. R15 body
-- geometry is skipped rather than mutating MeshParts and risking layered
-- clothing, ragdoll, or game-owned rig references.
local function applyAvatarBodyMeshes(preview, character, state)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local targetParts = getBodyParts(character)

    if not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R6 then
        warn("[Shingo's Changer] Bundle mesh transfer is R6-only; keeping this rig's original body geometry")
        return targetParts, 0, false
    end

    -- Back up and detach only the target's R6 body-package descriptors.
    -- Restoring the saved instances returns the exact original bundle.
    for _, obj in ipairs(character:GetChildren()) do
        if obj:IsA("CharacterMesh") then
            saveAndRemove(obj, state)
        end
    end

    -- Add the selected avatar's native R6 CharacterMesh objects.
    -- CharacterMesh changes rendered body geometry without replacing body
    -- Parts or their physics/rig connections.
    local meshCount = 0
    for _, obj in ipairs(preview:GetChildren()) do
        if obj:IsA("CharacterMesh") then
            copyObject(obj, character, state)
            meshCount += 1
        end
    end

    -- Transfer the R6 head's visible geometry without replacing the live Head
    -- Part. R6 Dynamic Head avatars are represented by a static SpecialMesh;
    -- copying that mesh reproduces the selected head shape while preserving the
    -- target's Motor6D, attachments, particles, and ragdoll references.
    -- FaceControls-based facial animation requires a skinned MeshPart head and
    -- is not available on the R6 Part-based head rig.
    local sourceHead = preview:FindFirstChild("Head")
    local targetHead = character:FindFirstChild("Head")
    if sourceHead and targetHead then
        state.headVisuals = {
            part = targetHead,
            transparency = targetHead.Transparency,
            localTransparencyModifier = targetHead.LocalTransparencyModifier
        }

        -- Replace only the visual SpecialMesh, never the physical Head Part.
        for _, child in ipairs(targetHead:GetChildren()) do
            if child:IsA("SpecialMesh") or child:IsA("Decal") or child:IsA("Texture") then
                saveAndRemove(child, state)
            end
        end

        for _, child in ipairs(sourceHead:GetChildren()) do
            if child:IsA("SpecialMesh") or child:IsA("Decal") or child:IsA("Texture") then
                copyObject(child, targetHead, state)
            end
        end

        -- Headless and partially transparent head assets are represented by
        -- the source Head's visibility. Keep the original physical part itself.
        targetHead.Transparency = sourceHead.Transparency
        targetHead.LocalTransparencyModifier = sourceHead.LocalTransparencyModifier
    end

    return targetParts, meshCount, true
end

local function applyAppearance(target, username)
    if not target then
        status.Text = "STATUS  /  Select a player first"
        return
    end

    if busyTargets[target] then
        status.Text = "STATUS  /  This player's avatar is still loading"
        return
    end

    if not target.Character then
        status.Text = "STATUS  /  Target character not found"
        return
    end

    if username == "" then
        status.Text = "STATUS  /  Enter a username"
        return
    end

    busyTargets[target] = true
    status.Text = "STATUS  /  Retrieving avatar data for @" .. target.Name .. "..."

    task.spawn(function()
        local preview
        local description
        local success, err = pcall(function()
            -- Re-applying to one player replaces only that player's override.
            restoreAppearance(target)

            local character = target.Character
            local humanoid =
                character:FindFirstChildOfClass("Humanoid")

            if not humanoid then
                error("Target Humanoid not found")
            end

            local userId

            if username:match("^%d+$") then
                userId = tonumber(username)
            else
                userId = Players:GetUserIdFromNameAsync(username)
            end

            if not userId then
                error("Username not found")
            end

            status.Text = "STATUS  /  Loading avatar appearance..."

            description =
                Players:GetHumanoidDescriptionFromUserIdAsync(userId)

            -- Temporary appearance model.
            -- This model is not used as the target character.
            preview = Players:CreateHumanoidModelFromDescriptionAsync(
                description,
                humanoid.RigType
            )

            description:Destroy()
            description = nil

            if not preview then
                error("Failed to create avatar model")
            end

            local state = {
                target = target,
                character = character,
                added = {},
                originals = {},
                colors = {}
            }

            activeAppearanceStates[target] = state

            -- Restore automatically if this target respawns.
            state.respawnConnection =
                target.CharacterAdded:Connect(function()
                    if activeAppearanceStates[target] == state then
                        restoreAppearance(target)
                        status.Text = "STATUS  /  Restored after @" .. target.Name .. " respawn"
                    end
                end)

            -- Apply body geometry to the existing target BaseParts in place.
            -- No rig parts, Motor6Ds, Attachments, or ragdoll constraints are replaced.
            local targetParts, meshCount, r6BundleSupported =
                applyAvatarBodyMeshes(preview, character, state)

            -- Replace avatar cosmetics, but keep game-owned effect accessories
            -- (auras, particles, trails, custom/unknown accessory rigs) in place.
            -- Their existing welds and attachments must continue following the rig.
            for _, obj in ipairs(character:GetChildren()) do
                if obj:IsA("Accessory") then
                    if not accessoryHasRuntimeEffects(obj) then
                        saveAndRemove(obj, state)
                    end
                elseif obj:IsA("Shirt")
                    or obj:IsA("Pants")
                    or obj:IsA("ShirtGraphic")
                    or obj:IsA("BodyColors") then
                    saveAndRemove(obj, state)
                end
            end

            -- Body colors
            local previewColors =
                preview:FindFirstChildOfClass("BodyColors")

            if previewColors then
                copyObject(previewColors, character, state)
            end

            -- Clothes
            copyObject(
                preview:FindFirstChildOfClass("Shirt"),
                character,
                state
            )

            copyObject(
                preview:FindFirstChildOfClass("Pants"),
                character,
                state
            )

            copyObject(
                preview:FindFirstChildOfClass("ShirtGraphic"),
                character,
                state
            )

            -- The original Head/body instances remain in place. Mesh geometry,
            -- visual surfaces, facial controls, and missing bones are copied
            -- without replacing game-owned Attachments or the physical rig.
            local sourceParts = getBodyParts(preview)
            for name, targetPart in pairs(targetParts) do
                local sourcePart = sourceParts[name]
                if sourcePart then
                    state.colors[targetPart] = targetPart.Color
                    targetPart.Color = sourcePart.Color
                end
            end

            -- Copy source accessories and attach them to the preserved target rig.
            local accessoryCount = 0

            for _, obj in ipairs(preview:GetChildren()) do
                if obj:IsA("Accessory") then
                    if applyAccessory(
                        obj,
                        character,
                        state,
                        targetParts
                    ) then
                        accessoryCount += 1
                    end
                end
            end

            preview:Destroy()
            preview = nil

            if r6BundleSupported then
                status.Text =
                    "STATUS  /  Applied / R6 body meshes: " .. meshCount ..
                    " / Accessories: " .. accessoryCount
            else
                status.Text =
                    "STATUS  /  Cosmetics applied; bundle geometry supports R6 only / Accessories: " .. accessoryCount
            end
        end)

        if preview then
            pcall(function()
                preview:Destroy()
            end)
        end

        if description then
            pcall(function()
                description:Destroy()
            end)
        end

        if not success then
            restoreAppearance(target)
            status.Text = "ERROR  /  " .. tostring(err)
            warn("[AppearanceChanger] " .. tostring(err))
        end

        busyTargets[target] = nil
    end)
end



--==================================================
-- LOCAL HUMANOID DISPLAY NAME OVERRIDE
-- Uses Roblox's native overhead name display (no BillboardGui).
-- The local property edit is intended for this client only.
--==================================================

local function restoreCustomDisplayName(target)
    local targetsToRestore = {}

    if target then
        table.insert(targetsToRestore, target)
    else
        for player in pairs(activeNameTagStates) do
            table.insert(targetsToRestore, player)
        end
    end

    for _, player in ipairs(targetsToRestore) do
        local state = activeNameTagStates[player]
        if state then
            activeNameTagStates[player] = nil

            if state.characterConnection then
                pcall(function()
                    state.characterConnection:Disconnect()
                end)
            end

            -- Restore every Humanoid touched by this player's override,
            -- including Humanoids from characters replaced during a respawn.
            for humanoid, originalName in pairs(state.originalDisplayNames) do
                pcall(function()
                    if humanoid and humanoid.Parent then
                        humanoid.DisplayName = originalName
                    end
                end)
            end
            table.clear(state.originalDisplayNames)
        end
    end
end

local function applyNameToHumanoid(state, character)
    if activeNameTagStates[state.target] ~= state or not character then
        return false
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
        or character:WaitForChild("Humanoid", 5)

    if not humanoid then
        return false
    end

    -- Save the value once so Restore Name can put it back exactly.
    if state.originalDisplayNames[humanoid] == nil then
        state.originalDisplayNames[humanoid] = humanoid.DisplayName
    end

    -- Roblox renders this value using its built-in character nameplate.
    -- No custom ScreenGui/BillboardGui is created and the game's display
    -- distance / health-bar settings are left untouched.
    local ok, err = pcall(function()
        humanoid.DisplayName = state.customName
    end)
    if not ok then
        warn("[UltimateChangerV5] Could not set Humanoid.DisplayName: " .. tostring(err))
        return false
    end
    return true
end

local function applyCustomDisplayName(target, customName)
    if not target or target == LocalPlayer then
        nameStatus.Text = "STATUS  /  Select another player"
        return
    end

    if not target.Parent or not target.Character then
        nameStatus.Text = "STATUS  /  Target character not found"
        return
    end

    customName = tostring(customName or ""):match("^%s*(.-)%s*$")
    if customName == "" then
        nameStatus.Text = "STATUS  /  Enter a display label"
        return
    end

    if #customName > 32 then
        nameStatus.Text = "STATUS  /  Name is limited to 32 characters"
        return
    end

    -- Re-applying to one player must not clear another player's custom name.
    restoreCustomDisplayName(target)

    local state = {
        target = target,
        customName = customName,
        originalDisplayNames = {},
        characterConnection = nil
    }

    activeNameTagStates[target] = state

    local ok, err = pcall(function()
        local attached = applyNameToHumanoid(state, target.Character)
        if not attached then
            error("Target Humanoid is not ready")
        end

        state.characterConnection = target.CharacterAdded:Connect(function(newCharacter)
            task.wait(0.25)
            if activeNameTagStates[target] == state then
                local success = applyNameToHumanoid(state, newCharacter)
                if not success then
                    nameStatus.Text = "STATUS  /  Waiting for target character"
                else
                    nameStatus.Text = "STATUS  /  Native name restored after respawn"
                end
            end
        end)
    end)

    if not ok then
        restoreCustomDisplayName(target)
        nameStatus.Text = "ERROR  /  " .. tostring(err)
        warn("[UltimateChangerV5] " .. tostring(err))
        return
    end

    nameStatus.Text = "STATUS  /  Local Humanoid name applied to @" .. target.Name
end


